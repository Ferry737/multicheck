.next
node_modules
# Secrets: ignore ALL .env variants except the documented example.
.env
.env.*
!.env.example

# QA / crash artifacts
core
core.*
*.core
.gstack/
# Throwaway QA scratch scripts only. NOT the committed release-gate scripts:
# this pattern silently swallowed scripts/qa-equivalent.sh (the PRODUCTION QA
# EQUIVALENT gate), which must be tracked and re-runnable.
scripts/qa-scratch-*.sh
scripts/qa-tmp-*.sh
tsconfig.tsbuildinfo

# Build / test output (reproducible)
dist/
build/
out/
coverage/
playwright-report/
test-results/
.turbo/
.vercel/

# Caches
.cache/
.npm/
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Credential-bearing artifacts (never commit)
auth.json
*.pem
*.key
id_rsa*
id_ed25519*

# OS temp
.DS_Store
Thumbs.db
